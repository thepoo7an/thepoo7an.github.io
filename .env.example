# Google Analytics 4 (GA4) Configuration
# Format: G-XXXXXXXXXX
# Local: Copy this file to .env and set your measurement ID:
#   VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GitHub Actions: Add VITE_GA_MEASUREMENT_ID as a Secret in:
#   Repository Settings -> Secrets and variables -> Actions
VITE_GA_MEASUREMENT_ID=

# Media CDN Base URL (Optional)
# If left empty, videos are served from local ./videos/ directory.
# For high-traffic or faster global delivery, upload videos to Cloudinary, Bunny.net, or S3/R2
# and set the base URL without trailing slash (e.g., https://media.thepoo7an.com or https://res.cloudinary.com/your-cloud)
VITE_MEDIA_BASE_URL=
